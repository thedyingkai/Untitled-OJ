# Development-only Compose compatibility values. Store production installs do
# not accept these variables; they use named ApiBindings and Deployment JWTs.
OJOS_WORKER_ID=worker-node-01
OJOS_WORKER_NAME=Worker Node 01
OJOS_JUDGE_API_URL=https://ojos.example.com/api
OJOS_WORKER_TOKEN=<worker-token>
OJOS_MAX_CONCURRENCY=2
OJOS_SUPPORTED_LANGUAGES=cpp17,c11,python3,java17
OJOS_HEARTBEAT_INTERVAL=10
OJOS_TASK_LEASE_TTL=60
OJOS_LOG_LEVEL=info
