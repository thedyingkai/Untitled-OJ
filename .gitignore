# Logs
logs
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Keep package-lock.json.
# Do NOT ignore package-lock.json.

# -------------------------
# Python cache, if scripts are added later
# -------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# -------------------------
# Docker / local runtime data
# -------------------------
docker-data/
data/
.local-data/

# -------------------------
# Database dumps / backups
# -------------------------
*.dump
*.sql.gz
*.tar.gz
*.zip
*.rar

# -------------------------
# Exported binary documents
# -------------------------
*.pdf
*.docx
*.pptx
*.xlsx
/storage

# -------------------------
# Project-critical files that must NOT be ignored:
# -------------------------
# deploy/migrations/*.sql
# deploy/compose/*.yml
# services/**/etc/*.yaml
# services/**/go.mod
# services/**/go.sum
# services/**/Cargo.toml
# services/**/Cargo.lock
# README.md
# docs/**
