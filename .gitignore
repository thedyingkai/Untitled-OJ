# OJOS workspace ignores

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Environment and local secrets
.env
.env.*
!.env.example
!.env.production.example

# Logs and local tokens
*.log
logs/
log/
compose-logs.txt
compose-ps.txt
tokens.local.json
/artifacts/

# Temporary files and caches
.tmp/
tmp/
temp/
.smoke/
.cache/
.cache-*/
.orchestrator-release-cache/
**/.ojos/
*.tmp
*.bak
*.old
*.orig
*.backup

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
go.work
go.work.sum
vendor/

# Local service binaries
services/auth/auth
services/auth/auth.exe
services/auth/ojos-auth
services/auth/ojos-auth.exe
services/gateway/gateway
services/gateway/gateway.exe
services/gateway/ojos-gateway
services/gateway/ojos-gateway.exe
services/judge-api/judge-api
services/judge-api/judge-api.exe
services/judge-api/ojos-judge-api
services/judge-api/ojos-judge-api.exe
services/problem-api/problem-api
services/problem-api/problem-api.exe

# Rust build artifacts
target/
services/*/target/
/.cargo-target-*/

# Frontend and Node
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/
.next/
.nuxt/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist-ssr
*.local
playwright-report/
test-results/

# OJOS packages and release artifacts
*.ojosmod
*.ojossvc
*.service.tar.zst

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Docker and local data
docker-data/
data/
.local-data/
/storage

# Database exports and binary documents
*.dump
*.sql.gz
*.tar.gz
*.zip
*.rar
*.pdf
*.docx
*.pptx
*.xlsx
