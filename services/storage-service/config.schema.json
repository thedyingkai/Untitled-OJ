{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ojos:storage-service:config:v1",
  "title": "Storage Service configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["development", "production"]
    },
    "backend": {
      "type": "string",
      "enum": ["local", "s3", "minio"]
    },
    "buckets": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,62}(?:,[a-z0-9][a-z0-9.-]{1,62})*$"
    },
    "localRoot": {
      "type": "string",
      "minLength": 1
    },
    "s3Endpoint": {
      "type": "string",
      "minLength": 1
    },
    "s3UseSSL": {
      "type": "boolean"
    },
    "s3Region": {
      "type": "string",
      "minLength": 1
    },
    "s3AccessKey": {
      "type": "string",
      "minLength": 1,
      "writeOnly": true,
      "x-ojos-secret": true
    },
    "s3SecretKey": {
      "type": "string",
      "minLength": 8,
      "writeOnly": true,
      "x-ojos-secret": true
    },
    "minioEndpoint": {
      "type": "string",
      "minLength": 1
    },
    "minioUseSSL": {
      "type": "boolean"
    },
    "minioAccessKey": {
      "type": "string",
      "minLength": 1,
      "writeOnly": true,
      "x-ojos-secret": true
    },
    "minioSecretKey": {
      "type": "string",
      "minLength": 8,
      "writeOnly": true,
      "x-ojos-secret": true
    }
  },
  "required": ["mode", "backend", "buckets"],
  "oneOf": [
    {
      "properties": {
        "mode": {"const": "development"},
        "backend": {"const": "local"}
      },
      "required": ["localRoot"],
      "not": {
        "anyOf": [
          {"required": ["minioAccessKey"]},
          {"required": ["minioSecretKey"]},
          {"required": ["s3AccessKey"]},
          {"required": ["s3SecretKey"]}
        ]
      }
    },
    {
      "properties": {
        "mode": {"const": "production"},
        "backend": {"const": "minio"}
      },
      "required": [
        "minioEndpoint",
        "minioUseSSL",
        "minioAccessKey",
        "minioSecretKey"
      ],
      "not": {"anyOf": [
        {"required": ["s3Endpoint"]},
        {"required": ["s3UseSSL"]},
        {"required": ["s3Region"]},
        {"required": ["s3AccessKey"]},
        {"required": ["s3SecretKey"]}
      ]}
    },
    {
      "properties": {
        "mode": {"const": "production"},
        "backend": {"const": "s3"}
      },
      "required": ["s3Endpoint", "s3UseSSL", "s3AccessKey", "s3SecretKey"],
      "not": {"anyOf": [
        {"required": ["minioEndpoint"]},
        {"required": ["minioUseSSL"]},
        {"required": ["minioAccessKey"]},
        {"required": ["minioSecretKey"]}
      ]}
    }
  ]
}
