syntax = "v1"

info (
	title:   "OJOS Storage Service API"
	desc:    "Object storage adapter API"
	author:  "thedyingkai"
	version: "v1"
)

type HealthResp {
	Status  string `json:"status"`
	Service string `json:"service"`
	Backend string `json:"backend"`
}

type BucketsResp {
	Buckets []string `json:"buckets"`
}

type BucketReq {
	Bucket string `path:"bucket"`
}

type BucketResp {
	Bucket  string `json:"bucket"`
	Created bool   `json:"created"`
}

type ObjectReq {
	Bucket string `path:"bucket"`
	Key    string `path:"key"`
}

type ObjectMetadata {
	Bucket      string `json:"bucket"`
	Key         string `json:"key"`
	SizeBytes   int64  `json:"size_bytes"`
	SHA256      string `json:"sha256"`
	ContentType string `json:"content_type"`
	UpdatedAt   string `json:"updated_at"`
}

type DeleteObjectResp {
	Deleted bool `json:"deleted"`
}

service storageservice {
	@handler health
	get /health returns (HealthResp)
}

@server (
	prefix: /api/storage
)
service storageservice {
	@handler listBuckets
	get /buckets returns (BucketsResp)

	@handler ensureBucket
	put /buckets/:bucket (BucketReq) returns (BucketResp)

	@handler putObject
	put /objects/:bucket/:key (ObjectReq) returns (ObjectMetadata)

	@handler getObject
	get /objects/:bucket/:key (ObjectReq)

	@handler headObject
	head /objects/:bucket/:key (ObjectReq)

	@handler deleteObject
	delete /objects/:bucket/:key (ObjectReq) returns (DeleteObjectResp)

	@handler getMetadata
	get /metadata/:bucket/:key (ObjectReq) returns (ObjectMetadata)
}
