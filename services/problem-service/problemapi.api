syntax = "v1"

info (
	title:   "OJOS Problem API"
	desc:    "File based Problem Package Core API"
	author:  "thedyingkai"
	version: "v1"
)

type HealthResp {
	Status string `json:"status"`
}

type CreateProblemReq {
	Title         string `json:"title"`
	Slug          string `json:"slug,optional"`
	Statement     string `json:"statement,optional"`
	TimeLimitMs   int    `json:"time_limit_ms,optional"`
	MemoryLimitMb int    `json:"memory_limit_mb,optional"`
	ProblemType   string `json:"problem_type,optional"`
	Visibility    string `json:"visibility,optional"`
	Difficulty    string `json:"difficulty,optional"`
	Tags          string `json:"tags,optional"`
}

type CreateProblemResp {
	ProblemId int64  `json:"problem_id"`
	Slug      string `json:"slug"`
}

type UpdateProblemReq {
	Id            int64  `path:"id"`
	Title         string `json:"title,optional"`
	Statement     string `json:"statement,optional"`
	TimeLimitMs   int    `json:"time_limit_ms,optional"`
	MemoryLimitMb int    `json:"memory_limit_mb,optional"`
	ProblemType   string `json:"problem_type,optional"`
	Visibility    string `json:"visibility,optional"`
	Difficulty    string `json:"difficulty,optional"`
	Tags          string `json:"tags,optional"`
	Status        string `json:"status,optional"`
}

type GetProblemReq {
	Id int64 `path:"id"`
}

type ProblemItem {
	Id             int64           `json:"id"`
	Slug           string          `json:"slug"`
	Title          string          `json:"title"`
	Statement      string          `json:"statement"`
	ProblemType    string          `json:"problem_type"`
	Visibility     string          `json:"visibility"`
	ManifestSha256 string          `json:"manifest_sha256"`
	SourceFormat   string          `json:"source_format"`
	Status         string          `json:"status"`
	Difficulty     string          `json:"difficulty"`
	Tags           string          `json:"tags"`
	TimeLimitMs    int             `json:"time_limit_ms"`
	MemoryLimitMb  int             `json:"memory_limit_mb"`
	CreatedBy      int64           `json:"created_by"`
	CreatedAt      string          `json:"created_at"`
	UpdatedAt      string          `json:"updated_at"`
	Samples        []ProblemSample `json:"samples,optional"`
}

type ProblemSample {
	CaseNo int    `json:"case_no"`
	Input  string `json:"input"`
	Output string `json:"output"`
}

type GetProblemResp {
	Problem ProblemItem `json:"problem"`
}

type ListProblemsReq {
	Page       int    `form:"page,optional"`
	PageSize   int    `form:"page_size,optional"`
	Keyword    string `form:"keyword,optional"`
	Visibility string `form:"visibility,optional"`
	Difficulty string `form:"difficulty,optional"`
	Tags       string `form:"tags,optional"`
}

type ListProblemsResp {
	Problems []ProblemItem `json:"problems"`
	Total    int64         `json:"total"`
}

type AddTestCaseReq {
	ProblemId     int64  `path:"id"`
	CaseNo        int    `json:"case_no,optional"`
	Input         string `json:"input"`
	Answer        string `json:"answer"`
	Score         int    `json:"score,optional"`
	Group         int    `json:"group,optional"`
	Sample        bool   `json:"sample,optional"`
	Hidden        bool   `json:"hidden,optional"`
	TimeLimitMs   int    `json:"time_limit_ms,optional"`
	MemoryLimitMb int    `json:"memory_limit_mb,optional"`
}

type AddTestCaseResp {
	CaseNo int `json:"case_no"`
}

type ListTestCasesReq {
	ProblemId int64 `path:"id"`
}

type TestCaseItem {
	No            int    `json:"no"`
	Input         string `json:"input"`
	Answer        string `json:"answer"`
	Score         int    `json:"score"`
	Group         int    `json:"group"`
	Sample        bool   `json:"sample"`
	Hidden        bool   `json:"hidden"`
	TimeLimitMs   int    `json:"time_limit_ms"`
	MemoryLimitMb int    `json:"memory_limit_mb"`
}

type PackageComponent {
	Type       string `json:"type"`
	Name       string `json:"name"`
	ConfigPath string `json:"config_path"`
}

type PackageLanguageLimit {
	Language      string `json:"language"`
	TimeLimitMs   int    `json:"time_limit_ms"`
	MemoryLimitMb int    `json:"memory_limit_mb"`
}

type PackageLimits {
	DefaultTimeLimitMs   int                    `json:"default_time_limit_ms"`
	DefaultMemoryLimitMb int                    `json:"default_memory_limit_mb"`
	Languages            []PackageLanguageLimit `json:"languages"`
}

type PackageSummary {
	Schema         string           `json:"schema"`
	Slug           string           `json:"slug"`
	Title          string           `json:"title"`
	ProblemType    string           `json:"problem_type"`
	Visibility     string           `json:"visibility"`
	Status         string           `json:"status"`
	SourceFormat   string           `json:"source_format"`
	ManifestSha256 string           `json:"manifest_sha256"`
	TotalCases     int              `json:"total_cases"`
	TotalScore     int              `json:"total_score"`
	SampleCount    int              `json:"sample_count"`
	FileCount      int              `json:"file_count"`
	SizeBytes      int64            `json:"size_bytes"`
	Limits         PackageLimits    `json:"limits"`
	Runner         PackageComponent `json:"runner"`
	Checker        PackageComponent `json:"checker"`
	Scorer         PackageComponent `json:"scorer"`
}

type PackageValidationIssue {
	Level   string `json:"level"`
	Code    string `json:"code"`
	Message string `json:"message"`
	Path    string `json:"path,optional"`
	CaseNo  int    `json:"case_no,optional"`
}

type PackageValidationResult {
	Valid    bool                     `json:"valid"`
	Errors   []PackageValidationIssue `json:"errors"`
	Warnings []PackageValidationIssue `json:"warnings"`
}

type GetProblemPackageReq {
	ProblemId int64 `path:"id"`
}

type GetProblemPackageResp {
	Package    PackageSummary          `json:"package"`
	Validation PackageValidationResult `json:"validation"`
}

type ValidateProblemPackageReq {
	ProblemId int64 `path:"id"`
}

type ValidateProblemPackageResp {
	Validation PackageValidationResult `json:"validation"`
}

type ListPackageCasesReq {
	ProblemId int64 `path:"id"`
}

type ListPackageCasesResp {
	Cases []TestCaseItem `json:"cases"`
}

type UpdateTestCaseReq {
	ProblemId     int64  `path:"id"`
	CaseNo        int    `path:"case_no"`
	Input         string `json:"input"`
	Answer        string `json:"answer"`
	Score         int    `json:"score,optional"`
	Group         int    `json:"group,optional"`
	Sample        bool   `json:"sample,optional"`
	Hidden        bool   `json:"hidden,optional"`
	TimeLimitMs   int    `json:"time_limit_ms,optional"`
	MemoryLimitMb int    `json:"memory_limit_mb,optional"`
}

type UpdateTestCaseResp {
	CaseNo int `json:"case_no"`
}

type ListTestCasesResp {
	Cases []TestCaseItem `json:"cases"`
}

type DeleteTestCaseReq {
	ProblemId int64 `path:"id"`
	CaseNo    int   `path:"case_no"`
}

type DeleteTestCaseResp {
	Deleted bool `json:"deleted"`
}

type DeleteProblemReq {
	Id int64 `path:"id"`
}

type DeleteProblemResp {
	Deleted bool `json:"deleted"`
}

service problemapi {
	@handler health
	get /health returns (HealthResp)
}

@server (
	prefix:     /problem
	middleware: UserContextMiddleware
)
service problemapi {
	@handler createProblem
	post /problems (CreateProblemReq) returns (CreateProblemResp)

	@handler listProblems
	get /problems (ListProblemsReq) returns (ListProblemsResp)

	@handler getProblemPackage
	get /problems/:id/package (GetProblemPackageReq) returns (GetProblemPackageResp)

	@handler validateProblemPackage
	post /problems/:id/package/validate (ValidateProblemPackageReq) returns (ValidateProblemPackageResp)

	@handler listPackageCases
	get /problems/:id/package/cases (ListPackageCasesReq) returns (ListPackageCasesResp)

	@handler getProblem
	get /problems/:id (GetProblemReq) returns (GetProblemResp)

	@handler updateProblem
	put /problems/:id (UpdateProblemReq) returns (GetProblemResp)

	@handler addTestCase
	post /problems/:id/test-cases (AddTestCaseReq) returns (AddTestCaseResp)

	@handler listTestCases
	get /problems/:id/test-cases (ListTestCasesReq) returns (ListTestCasesResp)

	@handler updateTestCase
	put /problems/:id/test-cases/:case_no (UpdateTestCaseReq) returns (UpdateTestCaseResp)

	@handler deleteTestCase
	delete /problems/:id/test-cases/:case_no (DeleteTestCaseReq) returns (DeleteTestCaseResp)

	@handler deleteProblem
	delete /problems/:id (DeleteProblemReq) returns (DeleteProblemResp)
}

