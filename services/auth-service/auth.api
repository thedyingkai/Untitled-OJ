syntax = "v1"

info (
	title:   "OJOS Auth API"
	desc:    "OJOS authentication service"
	author:  "thedyingkai"
	version: "v1"
)

type HealthData {
	Service string `json:"service"`
	Status  string `json:"status"`
}

type HealthResp {
	Code int        `json:"code"`
	Msg  string     `json:"msg"`
	Data HealthData `json:"data"`
}

type RegisterReq {
	Username string `json:"username"`
	Email    string `json:"email,optional"`
	Password string `json:"password"`
}

type RegisterData {
	UserId   int64  `json:"user_id"`
	Username string `json:"username"`
}

type RegisterResp {
	Code int          `json:"code"`
	Msg  string       `json:"msg"`
	Data RegisterData `json:"data,optional"`
}

type LoginReq {
	Username string `json:"username"`
	Password string `json:"password"`
}

type LoginData {
	Token       string   `json:"token"`
	UserId      int64    `json:"user_id"`
	Username    string   `json:"username"`
	Roles       []string `json:"roles"`
	Permissions []string `json:"permissions"`
}

type LoginResp {
	Code int       `json:"code"`
	Msg  string    `json:"msg"`
	Data LoginData `json:"data,optional"`
}

type ProfileData {
	UserId      int64    `json:"user_id"`
	Username    string   `json:"username"`
	Roles       []string `json:"roles"`
	Permissions []string `json:"permissions"`
}

type ProfileResp {
	Code int         `json:"code"`
	Msg  string      `json:"msg"`
	Data ProfileData `json:"data,optional"`
}

type UserItem {
	UserId    int64    `json:"user_id"`
	Username  string   `json:"username"`
	Email     string   `json:"email,optional"`
	Roles     []string `json:"roles"`
	CreatedAt string   `json:"created_at"`
}

type PageMeta {
	Page     int64 `json:"page"`
	PageSize int64 `json:"page_size"`
	Total    int64 `json:"total"`
}

type ListQueryReq {
	Page          int64  `form:"page,optional"`
	PageSize      int64  `form:"page_size,optional"`
	Q             string `form:"q,optional"`
	ServiceCode   string `form:"service_code,optional"`
	PrincipalType string `form:"principal_type,optional"`
	ScopeType     string `form:"scope_type,optional"`
	Action        string `form:"action,optional"`
}

type ListUsersResp {
	Code int        `json:"code"`
	Msg  string     `json:"msg"`
	Data []UserItem `json:"data"`
	Page PageMeta   `json:"page"`
}

type RoleItem {
	Id          int64  `json:"id"`
	Name        string `json:"name"`
	ServiceCode string `json:"service_code"`
	Description string `json:"description"`
	IsSystem    bool   `json:"is_system"`
}

type ListRolesResp {
	Code int        `json:"code"`
	Msg  string     `json:"msg"`
	Data []RoleItem `json:"data"`
	Page PageMeta   `json:"page"`
}

type PermissionItem {
	Code        string `json:"code"`
	ServiceCode string `json:"service_code"`
	Name        string `json:"name"`
	Description string `json:"description"`
}

type PermissionManageReq {
	Code        string `json:"code"`
	ServiceCode string `json:"service_code,optional"`
	Name        string `json:"name,optional"`
	Description string `json:"description,optional"`
}

type DeletePermissionReq {
	Code string `json:"code"`
}

type ResourceTypeManageReq {
	Code        string `json:"code"`
	ServiceCode string `json:"service_code,optional"`
	Name        string `json:"name,optional"`
	Description string `json:"description,optional"`
}

type DeleteResourceTypeReq {
	Code string `json:"code"`
}

type ResourceTypeItem {
	Code        string `json:"code"`
	ServiceCode string `json:"service_code"`
	Name        string `json:"name"`
	Description string `json:"description"`
	CreatedAt   string `json:"created_at"`
}

type ListResourceTypesResp {
	Code int                `json:"code"`
	Msg  string             `json:"msg"`
	Data []ResourceTypeItem `json:"data"`
	Page PageMeta           `json:"page"`
}

type RoleManageReq {
	Name        string `json:"name"`
	ServiceCode string `json:"service_code,optional"`
	Description string `json:"description,optional"`
	IsSystem    bool   `json:"is_system,optional"`
}

type DeleteRoleReq {
	Name string `json:"name"`
}

type RolePermissionReq {
	Role       string `json:"role"`
	Permission string `json:"permission"`
}

type RoleBindingItem {
	Id            int64  `json:"id"`
	PrincipalType string `json:"principal_type"`
	PrincipalId   int64  `json:"principal_id"`
	Role          string `json:"role"`
	ScopeType     string `json:"scope_type"`
	ScopeId       int64  `json:"scope_id"`
	GrantedByType string `json:"granted_by_type"`
	GrantedById   int64  `json:"granted_by_id"`
	ExpiresAt     string `json:"expires_at,optional"`
	CreatedAt     string `json:"created_at"`
}

type ListRoleBindingsResp {
	Code int               `json:"code"`
	Msg  string            `json:"msg"`
	Data []RoleBindingItem `json:"data"`
	Page PageMeta          `json:"page"`
}

type PermissionAssignmentItem {
	Id             int64  `json:"id"`
	PrincipalType  string `json:"principal_type"`
	PrincipalId    int64  `json:"principal_id"`
	PermissionCode string `json:"permission_code"`
	ScopeType      string `json:"scope_type"`
	ScopeId        int64  `json:"scope_id"`
	Effect         string `json:"effect"`
	Reason         string `json:"reason"`
	GrantedByType  string `json:"granted_by_type"`
	GrantedById    int64  `json:"granted_by_id"`
	ExpiresAt      string `json:"expires_at,optional"`
	CreatedAt      string `json:"created_at"`
}

type ListPermissionAssignmentsResp {
	Code int                        `json:"code"`
	Msg  string                     `json:"msg"`
	Data []PermissionAssignmentItem `json:"data"`
	Page PageMeta                   `json:"page"`
}

type ResourceEdgeItem {
	Id         int64  `json:"id"`
	ParentType string `json:"parent_type"`
	ParentId   int64  `json:"parent_id"`
	ChildType  string `json:"child_type"`
	ChildId    int64  `json:"child_id"`
	Relation   string `json:"relation"`
	CreatedAt  string `json:"created_at"`
}

type ListResourceEdgesResp {
	Code int                `json:"code"`
	Msg  string             `json:"msg"`
	Data []ResourceEdgeItem `json:"data"`
	Page PageMeta           `json:"page"`
}

type ServicePermissionItem {
	Code        string `json:"code"`
	Name        string `json:"name,optional"`
	Description string `json:"description,optional"`
}

type ServicePermissionRoleBinding {
	Role        string   `json:"role"`
	Permissions []string `json:"permissions"`
}

type ServiceIdentityGrantItem {
	ApiId      string `json:"api_id"`
	Permission string `json:"permission"`
}

type ServiceIdentityRegistration {
	ServiceName         string                     `json:"service_name,optional"`
	AllowedApis         []string                   `json:"allowed_apis,optional"`
	Grants              []ServiceIdentityGrantItem `json:"grants,optional"`
	CredentialToken     string                     `json:"credential_token,optional"`
	CredentialExpiresAt string                     `json:"credential_expires_at,optional"`
}

type RegisterServicePermissionsReq {
	ServiceCode         string                         `path:"service_code"`
	Permissions         []ServicePermissionItem        `json:"permissions"`
	DefaultRoleBindings []ServicePermissionRoleBinding `json:"default_role_bindings,optional"`
	ServiceIdentity     ServiceIdentityRegistration    `json:"service_identity,optional"`
}

type DeleteServicePermissionsReq {
	ServiceCode string `path:"service_code"`
}

type ServicePermissionsData {
	ServiceCode string   `json:"service_code"`
	Registered  int      `json:"registered"`
	Deleted     int64    `json:"deleted,optional"`
	Permissions []string `json:"permissions"`
}

type ServicePermissionsResp {
	Code int                    `json:"code"`
	Msg  string                 `json:"msg"`
	Data ServicePermissionsData `json:"data"`
}

type ListPermissionsResp {
	Code int              `json:"code"`
	Msg  string           `json:"msg"`
	Data []PermissionItem `json:"data"`
	Page PageMeta         `json:"page"`
}

type UserRoleReq {
	UserId int64  `json:"user_id"`
	Role   string `json:"role"`
}

type RoleBindingReq {
	TargetType string `json:"target_type"`
	TargetId   int64  `json:"target_id"`
	Role       string `json:"role"`
	ScopeType  string `json:"scope_type,optional"`
	ScopeId    int64  `json:"scope_id,optional"`
	ExpiresAt  string `json:"expires_at,optional"`
}

type PermissionAssignmentReq {
	TargetType string `json:"target_type"`
	TargetId   int64  `json:"target_id"`
	Permission string `json:"permission"`
	ScopeType  string `json:"scope_type,optional"`
	ScopeId    int64  `json:"scope_id,optional"`
	Effect     string `json:"effect,optional"`
	Reason     string `json:"reason,optional"`
	ExpiresAt  string `json:"expires_at,optional"`
}

type ResourceEdgeReq {
	ParentType string `json:"parent_type"`
	ParentId   int64  `json:"parent_id"`
	ChildType  string `json:"child_type"`
	ChildId    int64  `json:"child_id"`
	Relation   string `json:"relation,optional"`
}

type ProblemRoleReq {
	UserId    int64  `json:"user_id"`
	ProblemId int64  `json:"problem_id"`
	Role      string `json:"role"`
}

type PermissionCheckReq {
	UserId        int64  `json:"user_id,optional"`
	Permission    string `json:"permission"`
	ScopeType     string `json:"scope_type,optional"`
	ScopeId       int64  `json:"scope_id,optional"`
	CallerType    string `json:"caller_type,optional"`
	CallerService string `json:"caller_service,optional"`
	CallerNodeId  string `json:"caller_node_id,optional"`
	ApiId         string `json:"api_id,optional"`
}

type PermissionCheckData {
	Allowed bool `json:"allowed"`
}

type PermissionCheckResp {
	Code int                 `json:"code"`
	Msg  string              `json:"msg"`
	Data PermissionCheckData `json:"data"`
}

type UserEffectivePermissionsReq {
	UserId    int64  `path:"user_id"`
	ScopeType string `form:"scope_type,optional"`
	ScopeId   int64  `form:"scope_id,optional"`
}

type UserEffectivePermissionsData {
	UserId      int64    `json:"user_id"`
	ScopeType   string   `json:"scope_type"`
	ScopeId     int64    `json:"scope_id"`
	Permissions []string `json:"permissions"`
}

type UserEffectivePermissionsResp {
	Code int                          `json:"code"`
	Msg  string                       `json:"msg"`
	Data UserEffectivePermissionsData `json:"data"`
}

type AuditLogItem {
	Id             int64  `json:"id"`
	ActorType      string `json:"actor_type"`
	ActorId        int64  `json:"actor_id"`
	Action         string `json:"action"`
	TargetType     string `json:"target_type"`
	TargetId       int64  `json:"target_id"`
	PermissionCode string `json:"permission_code"`
	RoleName       string `json:"role_name"`
	ScopeType      string `json:"scope_type"`
	ScopeId        int64  `json:"scope_id"`
	Effect         string `json:"effect"`
	CreatedAt      string `json:"created_at"`
}

type ListAuditLogsResp {
	Code int            `json:"code"`
	Msg  string         `json:"msg"`
	Data []AuditLogItem `json:"data"`
	Page PageMeta       `json:"page"`
}

type ServiceCredentialItem {
	ServiceCode string `json:"service_code"`
	TokenHint   string `json:"token_hint"`
	Enabled     bool   `json:"enabled"`
	CreatedAt   string `json:"created_at"`
	UpdatedAt   string `json:"updated_at"`
	ExpiresAt   string `json:"expires_at,optional"`
	RevokedAt   string `json:"revoked_at,optional"`
	LastUsedAt  string `json:"last_used_at,optional"`
}

type ServiceGrantData {
	ApiId               string `json:"api_id"`
	Permission          string `json:"permission"`
	ProviderServiceCode string `json:"provider_service_code"`
	Enabled             bool   `json:"enabled"`
}

type ServiceIdentityData {
	ServiceCode string                  `json:"service_code"`
	Enabled     bool                    `json:"enabled"`
	Grants      []ServiceGrantData      `json:"grants"`
	Credentials []ServiceCredentialItem `json:"credentials"`
}

type ServiceIdentityResp {
	Code int                 `json:"code"`
	Msg  string              `json:"msg"`
	Data ServiceIdentityData `json:"data"`
}

type ServiceCredentialReq {
	ServiceCode string `path:"service_code"`
	Token       string `json:"token"`
	ExpiresAt   string `json:"expires_at,optional"`
}

type RevokeServiceCredentialReq {
	ServiceCode string `path:"service_code"`
	Token       string `json:"token,optional"`
	TokenHash   string `json:"token_hash,optional"`
	Reason      string `json:"reason,optional"`
}

type ServiceCredentialResp {
	Code int                   `json:"code"`
	Msg  string                `json:"msg"`
	Data ServiceCredentialItem `json:"data"`
}

type ActionData {
	Ok bool `json:"ok"`
}

type AdminActionResp {
	Code int        `json:"code"`
	Msg  string     `json:"msg"`
	Data ActionData `json:"data"`
}

service auth {
	@handler health
	get /health returns (HealthResp)
}

@server (
	prefix: /auth
)
service auth {
	@handler register
	post /register (RegisterReq) returns (RegisterResp)

	@handler login
	post /login (LoginReq) returns (LoginResp)
}

@server (
	prefix:     /auth
	middleware: AuthMiddleware
)
service auth {
	@handler profile
	get /profile returns (ProfileResp)

	@handler me
	get /me returns (ProfileResp)

	@handler listUsers
	get /admin/users (ListQueryReq) returns (ListUsersResp)

	@handler listRoles
	get /admin/roles (ListQueryReq) returns (ListRolesResp)

	@handler upsertRole
	post /admin/roles (RoleManageReq) returns (AdminActionResp)

	@handler deleteRole
	delete /admin/roles (DeleteRoleReq) returns (AdminActionResp)

	@handler grantRolePermission
	post /admin/role-permissions (RolePermissionReq) returns (AdminActionResp)

	@handler revokeRolePermission
	delete /admin/role-permissions (RolePermissionReq) returns (AdminActionResp)

	@handler listPermissions
	get /admin/permissions (ListQueryReq) returns (ListPermissionsResp)

	@handler upsertPermission
	post /admin/permissions (PermissionManageReq) returns (AdminActionResp)

	@handler deletePermission
	delete /admin/permissions (DeletePermissionReq) returns (AdminActionResp)

	@handler upsertResourceType
	post /admin/resource-types (ResourceTypeManageReq) returns (AdminActionResp)

	@handler listResourceTypes
	get /admin/resource-types (ListQueryReq) returns (ListResourceTypesResp)

	@handler deleteResourceType
	delete /admin/resource-types (DeleteResourceTypeReq) returns (AdminActionResp)

	@handler registerServicePermissions
	post /admin/services/:service_code/permissions (RegisterServicePermissionsReq) returns (ServicePermissionsResp)

	@handler deleteServicePermissions
	delete /admin/services/:service_code/permissions (DeleteServicePermissionsReq) returns (ServicePermissionsResp)

	@handler addUserRole
	post /admin/users/roles (UserRoleReq) returns (AdminActionResp)

	@handler removeUserRole
	delete /admin/users/roles (UserRoleReq) returns (AdminActionResp)

	@handler bindRole
	post /admin/role-bindings (RoleBindingReq) returns (AdminActionResp)

	@handler listRoleBindings
	get /admin/role-bindings (ListQueryReq) returns (ListRoleBindingsResp)

	@handler unbindRole
	delete /admin/role-bindings (RoleBindingReq) returns (AdminActionResp)

	@handler assignPermission
	post /admin/permission-assignments (PermissionAssignmentReq) returns (AdminActionResp)

	@handler listPermissionAssignments
	get /admin/permission-assignments (ListQueryReq) returns (ListPermissionAssignmentsResp)

	@handler revokePermission
	delete /admin/permission-assignments (PermissionAssignmentReq) returns (AdminActionResp)

	@handler addResourceEdge
	post /admin/resource-edges (ResourceEdgeReq) returns (AdminActionResp)

	@handler listResourceEdges
	get /admin/resource-edges (ListQueryReq) returns (ListResourceEdgesResp)

	@handler removeResourceEdge
	delete /admin/resource-edges (ResourceEdgeReq) returns (AdminActionResp)

	@handler getServiceIdentity
	get /admin/services/:service_code/identity returns (ServiceIdentityResp)

	@handler addServiceCredential
	post /admin/services/:service_code/credentials (ServiceCredentialReq) returns (ServiceCredentialResp)

	@handler revokeServiceCredential
	post /admin/services/:service_code/credentials/revoke (RevokeServiceCredentialReq) returns (AdminActionResp)

	@handler userEffectivePermissions
	get /admin/users/:user_id/effective-permissions (UserEffectivePermissionsReq) returns (UserEffectivePermissionsResp)

	@handler userPermissionCheck
	post /permission-check (PermissionCheckReq) returns (PermissionCheckResp)

	@handler addProblemRole
	post /admin/problems/roles (ProblemRoleReq) returns (AdminActionResp)

	@handler removeProblemRole
	delete /admin/problems/roles (ProblemRoleReq) returns (AdminActionResp)

	@handler permissionCheck
	post /admin/permission-check (PermissionCheckReq) returns (PermissionCheckResp)

	@handler listAuditLogs
	get /admin/audit-logs (ListQueryReq) returns (ListAuditLogsResp)
}
