{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ojos:contest-service:config:v1",
  "title": "Contest Service configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["open", "invite-only"],
          "default": "open"
        },
        "inviteSigningKey": {
          "type": "string",
          "minLength": 32,
          "writeOnly": true,
          "x-ojos-secret": true
        }
      },
      "required": ["mode"],
      "if": {
        "properties": {"mode": {"const": "invite-only"}},
        "required": ["mode"]
      },
      "then": {
        "required": ["inviteSigningKey"]
      },
      "else": {
        "not": {"required": ["inviteSigningKey"]}
      }
    }
  },
  "required": ["registration"]
}
