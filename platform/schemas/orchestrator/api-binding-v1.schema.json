{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ojos.dev/orchestrator/api-binding-v1.schema.json",
  "title": "OJOS API binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id", "requirement_name", "api_id", "consumer_deployment_id",
    "consumer_service_id", "consumer_node_id", "credential_generation",
    "context_generation", "desired_state", "observed_state", "health",
    "state", "created_at", "updated_at"
  ],
  "properties": {
    "binding_id": { "$ref": "#/$defs/stableId" },
    "requirement_name": { "$ref": "#/$defs/stableId" },
    "api_id": { "$ref": "#/$defs/stableId" },
    "api_version": { "type": "string" },
    "consumer_deployment_id": { "$ref": "#/$defs/nonEmpty" },
    "consumer_service_id": { "$ref": "#/$defs/nonEmpty" },
    "consumer_node_id": { "$ref": "#/$defs/nonEmpty" },
    "consumer_endpoint": { "type": "string" },
    "provider_deployment_id": { "type": "string" },
    "provider_service_id": { "type": "string" },
    "provider_node_id": { "type": "string" },
    "provider_endpoint": { "type": "string" },
    "provider_path": { "type": "string" },
    "virtual_endpoint": { "type": "string" },
    "protocol": { "type": "string" },
    "methods": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]+$" }, "uniqueItems": true },
    "auth_mode": { "type": "string" },
    "provider_auth_mode": { "type": "string" },
    "permission": { "type": "string" },
    "timeout_ms": { "type": ["integer", "null"], "minimum": 1, "maximum": 300000 },
    "topology_id": { "type": "string" },
    "topology_revision_id": { "type": "string" },
    "link_source_endpoint": { "type": "string" },
    "link_target_endpoint": { "type": "string" },
    "credential_ref": { "type": "string" },
    "credential_generation": { "type": "integer", "minimum": 1 },
    "context_generation": { "type": "integer", "minimum": 1 },
    "desired_state": { "enum": ["ACTIVE", "REVOKED"] },
    "observed_state": { "enum": ["PENDING", "RESOLVED", "ACTIVE", "REVOKED", "ERROR"] },
    "health": { "enum": ["UNKNOWN", "HEALTHY", "UNHEALTHY", "DEGRADED"] },
    "drift": { "type": "array", "items": { "type": "string" } },
    "last_operation_id": { "type": "string" },
    "state": {
      "description": "Compatibility projection. Writers MUST derive this value from desired_state, observed_state and optional; it is not an independent lifecycle input.",
      "enum": ["PENDING", "RESOLVED", "ACTIVE", "UNBOUND", "REVOKED", "ERROR"]
    },
    "optional": { "type": "boolean" },
    "reason": { "type": "string" },
    "created_at": { "$ref": "#/$defs/nonEmpty" },
    "updated_at": { "$ref": "#/$defs/nonEmpty" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "stableId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" }
  }
}
