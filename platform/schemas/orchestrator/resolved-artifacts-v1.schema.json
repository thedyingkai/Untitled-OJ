{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ojos.dev/schemas/orchestrator/resolved-artifacts-v1.schema.json",
  "title": "OJOS resolved build artifacts v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifacts"],
  "properties": {
    "schemaVersion": {"const": "ojos.dev/resolved-artifacts/v1"},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "digest", "size"],
      "properties": {
        "mediaType": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 1},
        "reference": {"type": "string", "minLength": 1, "pattern": "^\\S+$"}
      }
    }
  }
}
