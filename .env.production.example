# Copy this file into a secret manager or an untracked production env file.
# Values must be unique per environment. Empty values are intentional examples;
# deploy/ops/secret-check.sh must fail until real production secrets are supplied.

OJOS_ENVIRONMENT=production
OJOS_PUBLIC_BASE_URL=https://ojos.example.com

AUTH_POSTGRES_DB=ojos_auth
AUTH_POSTGRES_USER=ojos_auth_app
AUTH_POSTGRES_PASSWORD=
AUTH_DATABASE_URL=
# One-time initial administrator token file on the HOST. Generate 32-512
# URL-safe characters, chown the regular file to 65532:65532, set exact mode
# 0600, and remove
# this setting plus the Compose bind mount after successful bootstrap.
AUTH_ADMIN_BOOTSTRAP_SECRET_FILE=

PROBLEM_POSTGRES_DB=ojos_problem
PROBLEM_POSTGRES_USER=ojos_problem_app
PROBLEM_POSTGRES_PASSWORD=
PROBLEM_DATABASE_URL=

JUDGE_POSTGRES_DB=ojos_judge
JUDGE_POSTGRES_USER=ojos_judge_app
JUDGE_POSTGRES_PASSWORD=
JUDGE_DATABASE_URL=

USER_POSTGRES_DB=ojos_user
USER_POSTGRES_USER=ojos_user_app
USER_POSTGRES_PASSWORD=
USER_DATABASE_URL=

ORCHESTRATOR_POSTGRES_DB=ojos_orchestrator
ORCHESTRATOR_POSTGRES_USER=ojos_orchestrator_app
ORCHESTRATOR_POSTGRES_PASSWORD=
ORCHESTRATOR_DATABASE_URL=
# Used only by the migrate/migrate container. Its sslrootcert path is the
# fixed container target /run/secrets/orchestrator-postgres-ca.crt.
ORCHESTRATOR_MIGRATION_DATABASE_URL=
# When deploy/compose/docker-compose.yml is used, every certificate variable
# names an absolute HOST file. Compose mounts it read-only at a fixed path in
# the container; do not put the container target path here.
ORCHESTRATOR_POSTGRES_CA_CERT=
ORCHESTRATOR_ARTIFACT_DIR=/var/lib/ojos/orchestrator/artifacts
ORCHESTRATOR_WEB_ROOT=/opt/ojos/manager/web/dist
ORCHESTRATOR_HEALTHCHECK_URL=https://orchestrator:8090/api/v1/healthz/ready
ORCHESTRATOR_HEALTHCHECK_CA_CERT=
OJOS_BACKUP_TEXTFILE_DIR=/var/lib/ojos/node-exporter-textfile
# 160 is the production default; values below 128 are not accepted as a
# production override because 100 Nodes use fixed 25-second long polls.
ORCHESTRATOR_MAX_WORKERS=160
ORCHESTRATOR_LOG_RETENTION_DAYS=30
ORCHESTRATOR_ARTIFACT_RETENTION_DAYS=30
ORCHESTRATOR_ARTIFACT_QUOTA_BYTES=10737418240
# HTTPS listener and Node mTLS issuer (all four are required in production).
# The server certificate must include both its public DNS name and the Compose
# service DNS name `orchestrator`, which is used by the internal healthcheck.
ORCHESTRATOR_TLS_CERT=
ORCHESTRATOR_TLS_KEY=
ORCHESTRATOR_NODE_CA_CERT=
ORCHESTRATOR_NODE_CA_KEY=
# Service Contract v2 workload identity. The private/public PEM files are an
# Ed25519 keypair; only Auth receives the private half. The dedicated issuer
# token is held by Auth and the Orchestrator control plane, never by an Agent.
OJOS_WORKLOAD_PRIVATE_KEY_FILE=
OJOS_WORKLOAD_PUBLIC_KEY_FILE=
OJOS_WORKLOAD_KEY_ID=workload-1
OJOS_WORKLOAD_ISSUER=ojos-auth/workload
OJOS_WORKLOAD_AUDIENCE=ojos-gateway
ORCHESTRATOR_ALLOW_COMPOSE_BOOTSTRAP_HTTP=1
ORCHESTRATOR_AUTH_WORKLOAD_ORIGIN=http://auth-service:8081
ORCHESTRATOR_AUTH_WORKLOAD_TOKEN=
# Public HTTPS origin and CA bundle used by B-node managed deployments.
ORCHESTRATOR_GATEWAY_WORKLOAD_ORIGIN=https://ojos.example.com
ORCHESTRATOR_GATEWAY_WORKLOAD_CA_CERT=
# Dedicated 0600 copies of the same read-only discovery token. Separate files
# allow the two non-root containers to retain different filesystem ownership.
ORCHESTRATOR_OBSERVABILITY_TOKEN_FILE=
PROMETHEUS_ORCHESTRATOR_OBSERVABILITY_TOKEN_FILE=
# Explicit external Gateway HTTPS origin; never the legacy Compose DNS name.
ORCHESTRATOR_GATEWAY_OBSERVABILITY_ORIGIN=https://ojos.example.com
# Trusted Catalog v2 JSON. Sources are rejected unless signed by these keys.
ORCHESTRATOR_CATALOG_TRUST_KEYS={}
ORCHESTRATOR_CATALOG_SOURCES=[]
# Optional default credentials for private GitHub Catalog/package downloads.
# OJOS_GITHUB_TOKEN wins when both variables are present.
OJOS_GITHUB_TOKEN=
GITHUB_TOKEN=
# Auth/Gateway are reserved platform bootstrap services. The Orchestrator
# refuses production startup unless both providers and the issuer are complete.
ORCHESTRATOR_GATEWAY_ADMIN_ORIGIN=http://gateway:8080
ORCHESTRATOR_GATEWAY_ADMIN_TOKEN=
ORCHESTRATOR_AUTH_ADMIN_ORIGIN=http://auth-service:8081
ORCHESTRATOR_AUTH_ADMIN_TOKEN=
# Required by the PostgreSQL control plane. Discovery and JWKS must be HTTPS.
ORCHESTRATOR_OIDC_ISSUER=
ORCHESTRATOR_OIDC_AUDIENCE=ojos-orchestrator
ORCHESTRATOR_OIDC_CLIENT_ID=ojos-orchestrator-web
ORCHESTRATOR_OIDC_SCOPES=openid profile email
ORCHESTRATOR_PUBLIC_BASE_URL=https://ojos.example.com
# Top-level claim whose exact values map to the fixed v1 RBAC roles.
ORCHESTRATOR_OIDC_ROLE_CLAIM=roles
ORCHESTRATOR_OIDC_VIEWER_ROLE=viewer
ORCHESTRATOR_OIDC_OPERATOR_ROLE=operator
ORCHESTRATOR_OIDC_ADMIN_ROLE=admin
ORCHESTRATOR_OIDC_JWKS_CACHE_SECONDS=300
ORCHESTRATOR_OIDC_HTTP_TIMEOUT_SECONDS=5
# Optional, bounded non-blocking OTLP/HTTP export. Empty means zero exporter work.
ORCHESTRATOR_OTEL_EXPORTER_OTLP_ENDPOINT=
ORCHESTRATOR_OTEL_EXPORT_TIMEOUT_MS=2000
ORCHESTRATOR_OTEL_QUEUE_CAPACITY=1024

# Remote TUI public Device Authorization Grant client.
OJOS_TUI_OIDC_ISSUER=
OJOS_TUI_OIDC_CLIENT_ID=ojos-orchestrator-tui
OJOS_TUI_OIDC_SCOPE=openid profile
OJOS_TUI_OIDC_AUDIENCE=ojos-orchestrator

REDIS_PASSWORD=
REDIS_URL=

JWT_SECRET=
AUTH_INTERNAL_TOKEN=
ORCHESTRATOR_INTERNAL_TOKEN=
# Raw tokens are distributed only to their named managed services. The daemon
# receives the corresponding canonical sha256:<64 lowercase hex> verifiers.
ORCHESTRATOR_CONTRIBUTION_GATEWAY_ACK_TOKEN=
ORCHESTRATOR_CONTRIBUTION_AUTH_ACK_TOKEN=
ORCHESTRATOR_CONTRIBUTION_GATEWAY_ACK_TOKEN_SHA256=
ORCHESTRATOR_CONTRIBUTION_AUTH_ACK_TOKEN_SHA256=
OJOS_AUTH_PERMISSION_GATEWAY_ENDPOINT=http://gateway:8080
OJOS_AUTH_PERMISSION_CHECK_API_ID=auth.user.permission.check
OJOS_USER_SERVICE_TOKEN=
OJOS_PROBLEM_SERVICE_TOKEN=
OJOS_JUDGE_API_SERVICE_TOKEN=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true
GRAFANA_ADMIN_PASSWORD=
# 只有明确不部署监控时才改为 1；标准 preflight 会校验监控 Compose、告警与 Grafana 密钥。
OJOS_SKIP_MONITORING_CHECKS=0
OJOS_STORAGE_BUCKETS=problems,submissions,judge-artifacts,avatars

OJOS_BACKUP_DIR=/var/backups/ojos
ORCHESTRATOR_BACKUP_DIR=/var/backups/ojos-orchestrator
ORCHESTRATOR_BACKUP_RETENTION_DAYS=30
OJOS_STORAGE_ROOT=/var/lib/ojos/storage
OJOS_REDIS_RDB_PATH=/var/lib/redis/dump.rdb
OJOS_ALERT_WEBHOOK_URL=
