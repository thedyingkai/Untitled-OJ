OJOS_PUBLIC_BASE_URL=http://localhost:8080
OJOS_WORKER_TOKEN=replace-with-random-worker-token

POSTGRES_DB=ojos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DSN=postgres://postgres:replace-with-strong-password@postgres:5432/ojos?sslmode=disable
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-random-jwt-secret
INTERNAL_AUTH_ENABLED=true
MODULE_INSTALLER_INTERNAL_TOKEN=replace-with-random-installer-token
MODULE_INSTALLER_ENDPOINT=http://module-installer:8090

VITE_API_BASE_URL=http://localhost:8080/api

OJOS_WORKER_ID=worker-node-01
OJOS_WORKER_NAME=Worker Node 01
OJOS_CONTROL_PLANE_URL=http://localhost:8080/api
OJOS_MAX_CONCURRENCY=1
OJOS_SUPPORTED_LANGUAGES=cpp17,c11,python3,java17
OJOS_HEARTBEAT_INTERVAL=10
OJOS_TASK_LEASE_TTL=60
OJOS_ARTIFACT_CACHE_DIR=/var/lib/ojos-worker/cache
OJOS_WORK_DIR=/var/lib/ojos-worker/work
OJOS_LOG_LEVEL=info
