OJOS_PUBLIC_BASE_URL=http://localhost:8080
OJOS_WORKER_TOKEN=

AUTH_POSTGRES_DB=ojos_auth
AUTH_POSTGRES_USER=postgres
AUTH_POSTGRES_PASSWORD=
AUTH_DATABASE_URL=
PROBLEM_POSTGRES_DB=ojos_problem
PROBLEM_POSTGRES_USER=postgres
PROBLEM_POSTGRES_PASSWORD=
PROBLEM_DATABASE_URL=
JUDGE_POSTGRES_DB=ojos_judge
JUDGE_POSTGRES_USER=postgres
JUDGE_POSTGRES_PASSWORD=
JUDGE_DATABASE_URL=
USER_POSTGRES_DB=ojos_user
USER_POSTGRES_USER=postgres
USER_POSTGRES_PASSWORD=
USER_DATABASE_URL=
ORCHESTRATOR_POSTGRES_DB=ojos_orchestrator
ORCHESTRATOR_POSTGRES_USER=postgres
ORCHESTRATOR_POSTGRES_PASSWORD=
ORCHESTRATOR_DATABASE_URL=postgres://postgres:ojos-orchestrator-local@orchestrator-db:5432/ojos_orchestrator?sslmode=disable
ORCHESTRATOR_MIGRATION_DATABASE_URL=postgres://postgres:ojos-orchestrator-local@orchestrator-db:5432/ojos_orchestrator?sslmode=disable
# The explicit dev Compose override is ephemeral, but Compose still resolves
# and mounts the base file's certificate sources before merging services.
ORCHESTRATOR_POSTGRES_CA_CERT=./dev-secrets/placeholder
ORCHESTRATOR_HEALTHCHECK_CA_CERT=./dev-secrets/placeholder
ORCHESTRATOR_TLS_CERT=./dev-secrets/placeholder
ORCHESTRATOR_TLS_KEY=./dev-secrets/placeholder
ORCHESTRATOR_NODE_CA_CERT=./dev-secrets/placeholder
ORCHESTRATOR_NODE_CA_KEY=./dev-secrets/placeholder
# Base Compose resolves production workload-identity bind sources before the
# explicit development override removes the corresponding service settings.
ORCHESTRATOR_GATEWAY_WORKLOAD_CA_CERT=./dev-secrets/placeholder
OJOS_WORKLOAD_PRIVATE_KEY_FILE=./dev-secrets/placeholder
OJOS_WORKLOAD_PUBLIC_KEY_FILE=./dev-secrets/placeholder
ORCHESTRATOR_AUTH_WORKLOAD_TOKEN=DEV_ONLY_workload_issuer_token
ORCHESTRATOR_GATEWAY_WORKLOAD_ORIGIN=https://gateway.invalid
# ORCHESTRATOR_CATALOG_TRUST_KEYS={"catalog-prod":"<padded-base64-ed25519-public-key>"}
# ORCHESTRATOR_CATALOG_SOURCES=[{"id":"official","url":"https://catalog.example.com/v2/catalog.json","required_key_id":"catalog-prod"}]
# ORCHESTRATOR_GATEWAY_ADMIN_ORIGIN=https://gateway-admin.example.com
# ORCHESTRATOR_GATEWAY_ADMIN_TOKEN=
# ORCHESTRATOR_AUTH_ADMIN_ORIGIN=https://auth-admin.example.com
# ORCHESTRATOR_AUTH_ADMIN_TOKEN=
# PostgreSQL/remote control plane OIDC (required outside Desktop/--ephemeral).
# ORCHESTRATOR_OIDC_ISSUER=https://identity.example.com
# ORCHESTRATOR_OIDC_AUDIENCE=ojos-orchestrator
# ORCHESTRATOR_OIDC_CLIENT_ID=ojos-orchestrator-web
# ORCHESTRATOR_OIDC_SCOPES=openid profile email
# ORCHESTRATOR_PUBLIC_BASE_URL=https://orchestrator.example.com
# ORCHESTRATOR_OIDC_ROLE_CLAIM=roles
# ORCHESTRATOR_OIDC_VIEWER_ROLE=viewer
# ORCHESTRATOR_OIDC_OPERATOR_ROLE=operator
# ORCHESTRATOR_OIDC_ADMIN_ROLE=admin
# ORCHESTRATOR_OIDC_JWKS_CACHE_SECONDS=300
# ORCHESTRATOR_OIDC_HTTP_TIMEOUT_SECONDS=5
# ORCHESTRATOR_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4318
# ORCHESTRATOR_OTEL_EXPORT_TIMEOUT_MS=2000
# ORCHESTRATOR_OTEL_QUEUE_CAPACITY=1024
# Remote TUI Device Authorization Grant (no bearer-token environment fallback).
# OJOS_TUI_OIDC_ISSUER=https://identity.example.com
# OJOS_TUI_OIDC_CLIENT_ID=ojos-orchestrator-tui
# OJOS_TUI_OIDC_SCOPE=openid profile
# OJOS_TUI_OIDC_AUDIENCE=ojos-orchestrator
AUTH_SERVICE_ENDPOINT=http://auth-service:8081
REDIS_PASSWORD=DEV_ONLY_redis_password_not_for_production
REDIS_URL=redis://:DEV_ONLY_redis_password_not_for_production@redis:6379/0

JWT_SECRET=
INTERNAL_AUTH_ENABLED=true
ORCHESTRATOR_INTERNAL_TOKEN=ojos-local-internal

VITE_API_BASE_URL=http://localhost:8080/api

OJOS_WORKER_ID=worker-node-01
OJOS_WORKER_NAME=Worker Node 01
OJOS_JUDGE_API_URL=http://localhost:8080/api
OJOS_MAX_CONCURRENCY=1
OJOS_SUPPORTED_LANGUAGES=cpp17,c11,python3,java17
OJOS_HEARTBEAT_INTERVAL=10
OJOS_TASK_LEASE_TTL=60
OJOS_ARTIFACT_CACHE_DIR=/var/lib/ojos-worker/cache
OJOS_WORK_DIR=/var/lib/ojos-worker/work
OJOS_LOG_LEVEL=info

# --- 0.2.0 compatibility-only Store/Node settings ---
# These variables are read only by the `legacy-0_2` compatibility build.
# The 1.0 daemon uses trusted Catalog v2 + persistent Jobs + mTLS Agents.
# 商店索引：http(s) URL 或仓库内相对路径（默认 store/index.json）
OJOS_STORE_INDEX_URL=store/index.json
# GitHub API 令牌（可选：提升配额 / 私有仓库）
# OJOS_GITHUB_TOKEN=
# 置 1 后 release.install 真实下载 release 包（默认关闭为 deferred 计划）
# ORCHESTRATOR_RELEASE_PACKAGE_LOAD=1
# release 包缓存根目录（默认 repo root）
# ORCHESTRATOR_RELEASE_PACKAGE_ROOT=.

# --- 权限校验走编排器解析通道（默认关闭，回退直连 auth-service）---
# 置为内部 gateway 地址后，user-service / problem-service / judge-api 改用
# {gateway}/internal/apis/{api_id} 调权限校验，不再直连 AUTH_SERVICE_ENDPOINT。
# 开启前需先为调用方签发 service credential（POST /auth/admin/services/{code}/credentials）。
# OJOS_AUTH_PERMISSION_GATEWAY_ENDPOINT=http://gateway:8080
# 覆盖默认 api_id（默认 auth.user.permission.check）
# OJOS_AUTH_PERMISSION_CHECK_API_ID=auth.user.permission.check
# 调用方服务凭据；不能用 AUTH_INTERNAL_TOKEN 代替
# OJOS_USER_SERVICE_TOKEN=
# OJOS_PROBLEM_SERVICE_TOKEN=
# OJOS_JUDGE_API_SERVICE_TOKEN=
# OJOS_JUDGE_WORKER_SERVICE_TOKEN=

# --- Orchestrator v1 control plane ---
# Optional internal automation identity. Desktop/Web authentication uses
# HttpOnly sessions and never stores this value in browser storage.
# ORCHESTRATOR_INTERNAL_TOKEN=
# 0.2 compatibility checksum gate; Catalog v2 always verifies metadata SHA-256.
# ORCHESTRATOR_REQUIRE_RELEASE_CHECKSUM=1
# 允许 release 包源指向 loopback / 私网（内网私有镜像源才需要）。
# link-local（含 169.254.169.254 云元数据）始终拒绝，此开关不放行。
# ORCHESTRATOR_ALLOW_PRIVATE_RELEASE_SOURCE=1
# Desktop/test defaults to 32. Production defaults to 160 and ignores values
# below 128 so 100 simultaneous 25-second Agent claims cannot starve Web/API.
# ORCHESTRATOR_MAX_WORKERS=160
# ORCHESTRATOR_LOG_RETENTION_DAYS=30

# --- 0.2.0 compatibility-only Node push path (removed from 1.0) ---
# 控制面只在显式开启后把 release.install 分派给节点。
# ORCHESTRATOR_NODE_DISPATCH=1
# ORCHESTRATOR_NODE_ENDPOINT=http://127.0.0.1:8091
# 节点独立 bearer；生产环境至少 32 字符，不能复用控制面或业务服务令牌。
# ORCHESTRATOR_NODE_TOKEN=
# 节点是否允许实际执行 runtime driver。请求仍须同时传 execute_service_driver=true。
# ORCHESTRATOR_NODE_EXECUTE_SERVICE_DRIVER=1
# 允许 Node 真执行时必须绑定本机 IP；请求 host_ip 与 Endpoint host 都要完全匹配。
# ORCHESTRATOR_NODE_HOST_IP=127.0.0.1
